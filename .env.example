# Public URL, used for canonical links, the sitemap and WhatsApp share messages.
APP_URL=http://localhost:3000

# Postgres connection string. Tests run on an in-memory PGlite instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/realestate1

# The single admin login, applied by `pnpm db:seed`.
ADMIN_EMAIL=admin@royalhousingbd.com
ADMIN_PASSWORD=password

# "production" skips the demo content when seeding.
# NODE_ENV=production
